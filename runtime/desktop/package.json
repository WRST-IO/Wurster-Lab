{
  "name": "@wurster/desktop",
  "version": "0.20.1",
  "private": true,
  "description": "Wurster: a deliberately tiny Electron runtime for .wurst and .wrst mini apps.",
  "type": "module",
  "main": "src/main.mjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "node ../../tools/build-desktop-runtime.mjs windows x64",
    "dist:mac": "node ../../tools/build-desktop-runtime.mjs mac universal",
    "dist:mac:arm64": "node ../../tools/build-desktop-runtime.mjs mac arm64",
    "dist:mac:x64": "node ../../tools/build-desktop-runtime.mjs mac x64",
    "dist:mac:universal": "node ../../tools/build-desktop-runtime.mjs mac universal"
  },
  "dependencies": {
    "@wurster/format": "file:../../packages/format",
    "qrcode": "^1.5.4",
    "@wurster/meatgrinder": "file:../../packages/meatgrinder",
    "@wurster/interface": "file:../../packages/interface",
    "@wurster/session": "file:../../packages/session"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "io.wrst.wurster",
    "productName": "Wurster",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "build/icons/wurster.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons/wurster.ico",
      "artifactName": "Wurster-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Wurster",
      "runAfterFinish": true,
      "installerIcon": "build/icons/wurster.ico",
      "uninstallerIcon": "build/icons/wurster.ico",
      "installerSidebar": "build/icons/installerSidebar.bmp",
      "uninstallerSidebar": "build/icons/uninstallerSidebar.bmp",
      "include": "build/installer.nsh",
      "uninstallDisplayName": "Wurster"
    },
    "fileAssociations": [
      {
        "ext": "wurst",
        "name": "Wurster.Wurst",
        "description": "Portable Wurst mini application",
        "role": "Viewer",
        "icon": "icons/wurst-file.ico"
      },
      {
        "ext": "wrst",
        "name": "Wurster.Wrst",
        "description": "Portable WRST/Wurst mini application",
        "role": "Viewer",
        "icon": "icons/wurst-file.ico"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icons/wurster.icns",
      "artifactName": "Wurster-${version}-mac-${arch}.${ext}"
    },
    "protocols": [
      {
        "name": "Wurster Runtime Handoff",
        "schemes": [
          "wurster"
        ]
      }
    ]
  }
}
