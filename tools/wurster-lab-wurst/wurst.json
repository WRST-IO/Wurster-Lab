{
  "id": "io.wrst.wurster-lab",
  "name": "Wurster Lab",
  "version": "0.32.5",
  "type": "app",
  "entry": "index.html",
  "outputName": "WursterLab",
  "window": {
    "width": 980,
    "height": 760,
    "transparent": false,
    "frame": true,
    "resizable": true
  },
  "capabilities": {
    "files.open": true,
    "files.save": true
  },
  "application": {
    "protection": "public"
  },
  "protection": {
    "storedIdentity": true
  },
  "versionedOutput": false,
  "pigfs": {
    "format": "wurst/pigfs-policy-1",
    "writable": true,
    "realms": [
      {
        "id": "workspace",
        "label": "Wurster Workspace",
        "mount": "/workspace"
      },
      {
        "id": "lab",
        "label": "Lab Notes",
        "mount": "/lab"
      },
      {
        "id": "operator",
        "label": "WRST.IO Operator",
        "mount": "/operator",
        "governance": "personal"
      }
    ]
  }
}
