<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title }} · {% endif %}{{ site.title }}</title>
<meta name="description" content="{{ description or 'Ship entire web apps as portable .wurst files. Run them anywhere with the Wurster Runtime.' }}">
{% if noindex %}<meta name="robots" content="noindex,nofollow">{% endif %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/style.css">
{% if stylesheets %}{% for stylesheet in stylesheets %}
<link rel="stylesheet" href="{{ stylesheet }}">
{% endfor %}{% endif %}
</head>
<body>

<header class="site-header">
  <div class="site-header-bar">
    <a class="brand" href="/">
      <img src="/assets/img/pig.png" alt="Wurster pig">
      <span class="brand-name">{{ site.title }}<span class="brand-slash">/</span>{{ site.domain }}</span>
    </a>

    <nav class="main-nav">
      {% for link in site.nav %}
      <a href="{{ link.href }}">{{ link.label }}</a>
      {% endfor %}
    </nav>

    <div class="header-actions">
      <a class="btn btn-primary" href="/meatgrinder/"><img src="/assets/img/meatgrinder.png" style="width:18px;height:18px;object-fit:contain;" alt="">MeatGrinder</a>
      <a class="github-btn" href="https://github.com/WRST-IO/Wurster-Lab" title="GitHub Repository" target="_blank" rel="noopener noreferrer"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg></a>
      <label class="icon-btn nav-toggle mobile-nav-label" for="nav-toggle" aria-label="Menu">
        <input type="checkbox" id="nav-toggle" class="mobile-nav-label" style="display:none;">
        <span class="hamburger-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2C2333" stroke-width="2.4" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg></span>
        <span class="hamburger-emoji">🍔</span>
      </label>
    </div>
  </div>

  <nav class="mobile-nav">
    {% for link in site.nav %}
    <a href="{{ link.href }}">{{ link.label }}</a>
    {% endfor %}
    <a class="btn btn-primary" href="/meatgrinder/"><img src="/assets/img/meatgrinder.png" style="width:18px;height:18px;object-fit:contain;" alt="">MeatGrinder</a>
    <a class="btn btn-secondary" href="https://github.com/WRST-IO/Wurster-Lab" title="GitHub Repository" target="_blank" rel="noopener noreferrer"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>GitHub</a>
  </nav>
</header>

{{ content | safe }}

<footer class="site-footer">
  <div class="footer-top">
    <div class="footer-brand">
      <div class="footer-brand-row">
        <img src="/assets/img/pig.png" alt="Wurster">
        <span>{{ site.title }} · {{ site.domain }}</span>
      </div>
      <p>{{ site.tagline }}</p>
    </div>
    <div class="footer-cols">
      {% for col in site.footer.columns %}
      <div class="footer-col">
        <div class="footer-col-title">{{ col.title }}</div>
        {% for l in col.links %}
        <a href="{{ l.href }}">{{ l.label }}</a>
        {% endfor %}
      </div>
      {% endfor %}
    </div>
  </div>
  <div class="footer-bottom">
    <span>&copy; {{ year }} {{ site.title }} — All rights reserved.</span>
    <img src="/assets/img/wurst-badge.png" alt="Wurst badge">
  </div>
</footer>

</body>
</html>
